@page
@model TiendaRopa.Pages.Carrito.IndexModel
@{
    ViewData["Title"] = "Carrito de Compras";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Mi Carrito de Compras</h2>
    <a asp-page="/Productos/Index" class="btn btn-outline-secondary">← Seguir Comprando</a>
</div>

<div id="contenedor-alertas">
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

@if (Model.Carrito == null || !Model.Carrito.Items.Any())
{
    <div class="card p-4 text-center shadow-sm">
        <h4 class="text-muted">Tu carrito está vacío</h4>
        <p class="text-secondary">Explora nuestro catálogo y agrega las prendas que más te gusten.</p>
        <div>
            <a asp-page="/Productos/Index" class="btn btn-primary">Ver catálogo de productos</a>
        </div>
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th>Talla</th>
                    <th>Color</th>
                    <th>Precio</th>
                    <th style="width: 180px;">Cantidad</th>
                    <th>Subtotal</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Carrito.Items)
                {
                    var precioUnitario = item.Variante?.Producto?.Precio ?? 0;
                    var maxStock = item.Variante?.Stock ?? 999;
                    var subtotal = precioUnitario * item.Cantidad;
                    <tr id="fila-@item.IdItemCarrito">
                        <td>
                            <strong>@item.Variante?.Producto?.Nombre</strong>
                        </td>
                        <td><span class="badge bg-secondary">@(item.Variante?.Talla?.Nombre ?? "N/A")</span></td>
                        <td><span class="badge bg-info text-dark">@(item.Variante?.Color?.Nombre ?? "N/A")</span></td>
                        <td>S/ @precioUnitario.ToString("F2")</td>
                        <td>
                            <form method="post" asp-page-handler="ActualizarCantidad" class="form-cantidad d-flex align-items-center" data-id-item="@item.IdItemCarrito" data-stock="@maxStock">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idItem" value="@item.IdItemCarrito" />
                                <div class="input-group input-group-sm">
                                    <button type="button" class="btn btn-outline-secondary btn-restar" @(item.Cantidad <= 1 ? "disabled" : "")>-</button>
                                    <input type="number" name="cantidad" value="@item.Cantidad" min="1" max="@maxStock" class="form-control text-center input-cantidad" style="max-width: 60px;" />
                                    <button type="button" class="btn btn-outline-secondary btn-sumar" @(item.Cantidad >= maxStock ? "disabled" : "")>+</button>
                                </div>
                                <noscript>
                                    <button type="submit" class="btn btn-sm btn-link">Actualizar</button>
                                </noscript>
                            </form>
                        </td>
                        <td><strong>S/ <span class="item-subtotal">@subtotal.ToString("F2")</span></strong></td>
                        <td>
                            <form method="post" asp-page-handler="Eliminar">
                                <input type="hidden" name="idItem" value="@item.IdItemCarrito" />
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Deseas quitar este producto del carrito?');">Quitar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card mt-4 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0">Total a Pagar: <span class="text-success fw-bold">S/ <span id="total-carrito">@Model.Total.ToString("F2")</span></span></h4>
            </div>
            <div>
                <a asp-page="/Productos/Index" class="btn btn-outline-secondary me-2">Seguir Comprando</a>
                <a asp-page="/Checkout/Index" class="btn btn-primary btn-lg">Continuar Compra →</a>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const forms = document.querySelectorAll(".form-cantidad");

            forms.forEach(form => {
                const input = form.querySelector(".input-cantidad");
                const btnRestar = form.querySelector(".btn-restar");
                const btnSumar = form.querySelector(".btn-sumar");
                const idItem = form.querySelector("input[name='idItem']").value;
                const tokenInput = form.querySelector("input[name='__RequestVerificationToken']");
                const token = tokenInput ? tokenInput.value : "";
                const stock = parseInt(form.getAttribute("data-stock")) || 999;

                function enviarActualizacion(nuevaCantidad) {
                    if (nuevaCantidad < 1) nuevaCantidad = 1;
                    if (nuevaCantidad > stock) nuevaCantidad = stock;

                    const formData = new FormData();
                    formData.append("idItem", idItem);
                    formData.append("cantidad", nuevaCantidad);
                    if (token) {
                        formData.append("__RequestVerificationToken", token);
                    }

                    fetch(window.location.pathname + "?handler=ActualizarCantidad", {
                        method: "POST",
                        body: formData,
                        headers: {
                            "X-Requested-With": "XMLHttpRequest",
                            "Accept": "application/json"
                        }
                    })
                    .then(response => {
                        if (!response.ok) throw new Error("Error en la solicitud");
                        return response.json();
                    })
                    .then(data => {
                        if (data.exito) {
                            input.value = data.cantidad;
                            const fila = document.getElementById("fila-" + idItem);
                            if (fila) {
                                const subtotalSpan = fila.querySelector(".item-subtotal");
                                if (subtotalSpan && data.subtotal) {
                                    subtotalSpan.textContent = data.subtotal;
                                }
                            }
                            const totalSpan = document.getElementById("total-carrito");
                            if (totalSpan && data.total) {
                                totalSpan.textContent = data.total;
                            }

                            btnRestar.disabled = (data.cantidad <= 1);
                            btnSumar.disabled = (data.cantidad >= stock);
                        } else {
                            mostrarAlerta(data.mensaje || "Error al actualizar cantidad", "danger");
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        form.submit();
                    });
                }

                btnRestar.addEventListener("click", function () {
                    let actual = parseInt(input.value) || 1;
                    if (actual > 1) {
                        enviarActualizacion(actual - 1);
                    }
                });

                btnSumar.addEventListener("click", function () {
                    let actual = parseInt(input.value) || 1;
                    if (actual < stock) {
                        enviarActualizacion(actual + 1);
                    }
                });

                input.addEventListener("change", function () {
                    let actual = parseInt(input.value) || 1;
                    enviarActualizacion(actual);
                });
            });

            function mostrarAlerta(mensaje, tipo) {
                const contenedor = document.getElementById("contenedor-alertas");
                if (!contenedor) return;
                const alerta = document.createElement("div");
                alerta.className = `alert alert-${tipo} alert-dismissible fade show`;
                alerta.role = "alert";
                alerta.innerHTML = `${mensaje}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>`;
                contenedor.appendChild(alerta);
            }
        });
    </script>
}