<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TiendaRopa — Moda, estilo y calidad premium. Explora nuestra colección de prendas con múltiples tallas y colores." />
    <title>@ViewData["Title"] — TiendaRopa</title>

    <!-- Bootstrap (sólo utilidades grid/spacing que reutiliza el proyecto) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Diseño público premium -->
    <link rel="stylesheet" href="~/css/tienda.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TiendaRopa.styles.css" asp-append-version="true" />
</head>
<body>

<!-- ╔══════════════════════════════════════════╗
     ║  NAVEGACIÓN PÚBLICA — glassmorphism       ║
     ╚══════════════════════════════════════════╝ -->
<nav class="tienda-nav" id="tiendaNav">
    <!-- Brand -->
    <a asp-page="/Index" class="nav-brand">
        <span class="nav-brand-dot"></span>
        TiendaRopa
    </a>

    <!-- Links (desktop) -->
    <ul class="nav-links" id="navLinks">
        <li><a asp-page="/Index">Inicio</a></li>
        <li><a asp-page="/Productos/Index">Catálogo</a></li>
        <li><a asp-page="/Pedidos/Index">Mis Pedidos</a></li>
        <li><a asp-page="/Clientes/Registrar">Mi Cuenta</a></li>
    </ul>

    <!-- Acciones (desktop) -->
    <div class="nav-actions">
        <a asp-page="/Carrito/Index" class="nav-btn-cart">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span class="cart-label">Carrito</span>
        </a>
        <a asp-page="/Admin/Index" class="nav-btn-admin">
            <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            Admin
        </a>
        <!-- Hamburger mobile -->
        <button class="nav-toggle" id="navToggle" aria-label="Menú" type="button">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>
    </div>
</nav>

<!-- ╔══════════════════════════════════════════╗
     ║  CONTENIDO PRINCIPAL                      ║
     ╚══════════════════════════════════════════╝ -->
<div class="tienda-wrapper">
    @RenderBody()
</div>

<!-- ╔══════════════════════════════════════════╗
     ║  FOOTER                                   ║
     ╚══════════════════════════════════════════╝ -->
<footer class="tienda-footer">
    <div class="container-tienda">
        <div class="footer-inner">
            <a asp-page="/Index" class="footer-brand">TiendaRopa</a>
            <nav class="footer-links">
                <a asp-page="/Productos/Index">Catálogo</a>
                <a asp-page="/Carrito/Index">Carrito</a>
                <a asp-page="/Clientes/Registrar">Cuenta</a>
                <a asp-page="/Privacy">Privacidad</a>
            </nav>
            <span>&copy; @DateTime.Now.Year TiendaRopa — Todos los derechos reservados</span>
        </div>
    </div>
</footer>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    /* ── Scroll effect on navbar ── */
    const nav = document.getElementById('tiendaNav');
    window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });

    /* ── Mobile toggle ── */
    const navToggle = document.getElementById('navToggle');
    const navLinks  = document.getElementById('navLinks');
    navToggle?.addEventListener('click', () => {
        navLinks.classList.toggle('open');
    });
    /* Close on outside click */
    document.addEventListener('click', e => {
        if (!nav.contains(e.target)) navLinks.classList.remove('open');
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>