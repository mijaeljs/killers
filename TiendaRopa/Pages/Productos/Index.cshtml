@page
@model TiendaRopa.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "CatÃ¡logo";
    var categorias = Model.Productos
        .Select(p => p.Categoria?.Nombre)
        .Where(c => c != null)
        .Distinct()
        .OrderBy(c => c)
        .ToList();
}

<!-- â•”â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•—
     â•‘  CATALOGO HEADER                          â•‘
     â•šâ•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="section" style="padding-bottom:0;">
    <div class="container-tienda">
        <div class="tienda-page-header">
            <span class="section-tag">ColecciÃ³n Completa</span>
            <h1 class="section-title">CatÃ¡logo de Prendas</h1>
            <p class="section-sub">Explora todas nuestras prendas â€” elige talla, color y agrega directo al carrito.</p>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Filter Bar -->
        @if (categorias.Any())
        {
            <div class="filter-bar">
                <button class="cat-chip active" onclick="filterCategory(this, 'all')">Todas</button>
                @foreach (var cat in categorias)
                {
                    <button class="cat-chip" onclick="filterCategory(this, '@cat')">@cat</button>
                }
            </div>
        }
    </div>
</div>

<!-- â•”â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•—
     â•‘  GRILLA DE PRODUCTOS                      â•‘
     â•šâ•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="section" style="padding-top:2rem;">
    <div class="container-tienda">

        @if (!Model.Productos.Any())
        {
            <div class="empty-state">
                <svg width="80" height="80" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
                <h3>No hay productos disponibles</h3>
                <p>Vuelve pronto â€” estamos preparando nuevas prendas para ti.</p>
            </div>
        }
        else
        {
            <div class="productos-grid" id="productosGrid">
                @foreach (var producto in Model.Productos)
                {
                    var catNombre = producto.Categoria?.Nombre ?? "Sin categorÃ­a";
                    <article class="producto-card" data-categoria="@catNombre">

                        <!-- Imagen / Placeholder -->
                        <div class="producto-card-img">
                            <div class="producto-img-placeholder">
                                <svg width="64" height="64" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                                </svg>
                            </div>
                            <span class="producto-badge">@catNombre</span>
                        </div>

                        <!-- Cuerpo -->
                        <div class="producto-card-body">
                            <div class="producto-categoria">@catNombre</div>
                            <h2 class="producto-nombre">@producto.Nombre</h2>
                            @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                            {
                                <p class="producto-descripcion">@producto.Descripcion</p>
                            }

                            <!-- Precio -->
                            <div class="producto-precio-row">
                                <span class="producto-precio-moneda">S/</span>
                                <span class="producto-precio">@producto.Precio.ToString("N2")</span>
                            </div>

                            <!-- Variantes -->
                            @if (producto.Variantes.Any())
                            {
                                <p class="variantes-label">Tallas &amp; Colores disponibles</p>
                                <div class="variantes-list">
                                    @foreach (var variante in producto.Variantes)
                                    {
                                        <div class="variante-row">
                                            <div class="variante-info">
                                                <span class="tag-talla">@(variante.Talla?.Nombre ?? "?")</span>
                                                <span class="tag-color">@(variante.Color?.Nombre ?? "?")</span>
                                                @if (variante.Stock > 0)
                                                {
                                                    <span class="tag-stock-ok">@variante.Stock uds.</span>
                                                }
                                                else
                                                {
                                                    <span class="tag-stock-no">Agotado</span>
                                                }
                                            </div>
                                            <div class="variante-action">
                                                @if (variante.Stock > 0)
                                                {
                                                    <form method="post" asp-page-handler="Agregar" class="d-flex align-items-center gap-1">
                                                        <input type="hidden" name="idVariante" value="@variante.IdVariante" />
                                                        <input type="number" name="cantidad" value="1" min="1" max="@variante.Stock"
                                                               class="input-qty" title="Cantidad" />
                                                        <button type="submit" class="btn-agregar" title="Agregar al carrito">
                                                            <svg width="11" height="11" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                                                            </svg>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="btn-agotado">N/A</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="no-variantes">Sin variantes registradas</p>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
function filterCategory(btn, cat) {
    /* Update active chip */
    document.querySelectorAll('.cat-chip').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');

    /* Filter cards */
    document.querySelectorAll('#productosGrid .producto-card').forEach(card => {
        if (cat === 'all' || card.dataset.categoria === cat) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });
}
</script>
}

