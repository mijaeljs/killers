@page
@model TiendaRopa.Pages.Admin.Variantes.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Variantes";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="admin-header-title">Variantes de Productos</h1>
        <p class="admin-header-sub">Combinaciones de Producto + Talla + Color + Existencias individuales</p>
    </div>
    <a asp-page="Crear" asp-route-idProducto="@Model.IdProducto" class="btn btn-primary d-inline-flex align-items-center gap-1">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        + Nueva Variante
    </a>
</div>

<!-- Filtros -->
<div class="admin-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <select asp-for="IdProducto" asp-items="Model.ProductosFiltro" class="form-select">
                <option value="">-- Filtrar por Producto (Todos) --</option>
            </select>
        </div>
        <div class="col-12 col-md-4">
            <input type="text" asp-for="Buscar" class="form-control" placeholder="Buscar por talla o color..." />
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-100">Filtrar</button>
            @if (Model.IdProducto.HasValue || !string.IsNullOrEmpty(Model.Buscar))
            {
                <a asp-page="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </form>
</div>

<!-- Tabla de Variantes -->
<div class="admin-card">
    @if (!Model.Variantes.Any())
    {
        <div class="alert alert-info mb-0">
            No se encontraron variantes registradas con los criterios seleccionados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Talla</th>
                        <th>Color</th>
                        <th>Stock Actual</th>
                        <th style="width: 180px;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Variantes)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@v.IdVariante</span></td>
                            <td>
                                <div><strong class="text-dark">@v.Producto?.Nombre</strong></div>
                                <small class="text-muted">Precio: S/ @(v.Producto?.Precio.ToString("F2") ?? "0.00")</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@(v.Producto?.Categoria?.Nombre ?? "Sin categoría")</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fs-6">@(v.Talla?.Nombre ?? "N/A")</span>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark fs-6">@(v.Color?.Nombre ?? "N/A")</span>
                            </td>
                            <td>
                                @if (v.Stock == 0)
                                {
                                    <span class="badge bg-danger">Agotado (0)</span>
                                }
                                else if (v.Stock <= 5)
                                {
                                    <span class="badge bg-warning text-dark">Stock Bajo (@v.Stock)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@v.Stock unidades</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-page="Editar" asp-route-id="@v.IdVariante" class="btn btn-sm btn-outline-secondary">
                                        Editar
                                    </a>
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@v.IdVariante" onsubmit="return confirm('¿Está seguro de eliminar esta variante?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
