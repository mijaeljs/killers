@page
@model TiendaRopa.Pages.Admin.Tallas.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Tallas";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="admin-header-title">Tallas de Prendas</h1>
        <p class="admin-header-sub">Configuración de medidas y tallaje disponible para productos</p>
    </div>
    <a asp-page="Crear" class="btn btn-primary d-inline-flex align-items-center gap-1">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        + Nueva Talla
    </a>
</div>

<div class="admin-card">
    @if (!Model.Tallas.Any())
    {
        <div class="alert alert-info mb-0">
            No existen tallas registradas. Haga clic en "+ Nueva Talla" para registrar una (Ej: S, M, L, XL).
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Nombre de Talla</th>
                        <th>Variantes Activas</th>
                        <th style="width: 180px;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Tallas)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@t.IdTalla</span></td>
                            <td><strong class="text-dark fs-6">@t.Nombre</strong></td>
                            <td>
                                <span class="badge @(t.Variantes.Count > 0 ? "bg-primary" : "bg-secondary")">
                                    @t.Variantes.Count variante(s)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-page="Editar" asp-route-id="@t.IdTalla" class="btn btn-sm btn-outline-secondary">
                                        Editar
                                    </a>
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@t.IdTalla" onsubmit="return confirm('¿Está seguro de eliminar esta talla?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" @(t.Variantes.Count > 0 ? "title='Tiene variantes asociadas'" : "")>
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
