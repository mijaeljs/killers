@page
@model TiendaRopa.Pages.Admin.Colores.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Colores";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="admin-header-title">Colores de Prendas</h1>
        <p class="admin-header-sub">Paleta de tonalidades disponibles para las prendas de la tienda</p>
    </div>
    <a asp-page="Crear" class="btn btn-primary d-inline-flex align-items-center gap-1">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        + Nuevo Color
    </a>
</div>

<div class="admin-card">
    @if (!Model.Colores.Any())
    {
        <div class="alert alert-info mb-0">
            No existen colores registrados. Haga clic en "+ Nuevo Color" para agregar colores (Ej: Negro, Blanco, Azul Marino, Rojo).
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Nombre del Color</th>
                        <th>Variantes Activas</th>
                        <th style="width: 180px;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Colores)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@c.IdColor</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="d-inline-block rounded-circle border" style="width: 16px; height: 16px; background-color: @(c.Nombre.ToLower() switch {
                                        "negro" => "#000000",
                                        "blanco" => "#ffffff",
                                        "rojo" => "#ef4444",
                                        "azul" => "#3b82f6",
                                        "azul marino" => "#1e3a8a",
                                        "verde" => "#22c55e",
                                        "gris" => "#6b7280",
                                        "amarillo" => "#eab308",
                                        "rosado" or "rosa" => "#ec4899",
                                        "beige" => "#f5f5dc",
                                        _ => "#cbd5e1"
                                    });"></span>
                                    <strong class="text-dark">@c.Nombre</strong>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(c.Variantes.Count > 0 ? "bg-primary" : "bg-secondary")">
                                    @c.Variantes.Count variante(s)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-page="Editar" asp-route-id="@c.IdColor" class="btn btn-sm btn-outline-secondary">
                                        Editar
                                    </a>
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@c.IdColor" onsubmit="return confirm('¿Está seguro de eliminar este color?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" @(c.Variantes.Count > 0 ? "title='Tiene variantes asociadas'" : "")>
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
