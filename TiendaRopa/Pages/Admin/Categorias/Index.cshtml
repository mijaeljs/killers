@page
@model TiendaRopa.Pages.Admin.Categorias.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="admin-header-title">Categorías de Ropa</h1>
        <p class="admin-header-sub">Clasificación de productos disponibles para la tienda pública</p>
    </div>
    <a asp-page="Crear" class="btn btn-primary d-inline-flex align-items-center gap-1">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        + Nueva Categoría
    </a>
</div>

<div class="admin-card">
    @if (!Model.Categorias.Any())
    {
        <div class="alert alert-info mb-0">
            No existen categorías registradas en la base de datos. Haga clic en "+ Nueva Categoría" para agregar la primera.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Nombre de Categoría</th>
                        <th>Prendas Vinculadas</th>
                        <th style="width: 180px;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Categorias)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@c.IdCategoria</span></td>
                            <td><strong class="text-dark">@c.Nombre</strong></td>
                            <td>
                                <span class="badge @(c.Productos.Count > 0 ? "bg-primary" : "bg-secondary")">
                                    @c.Productos.Count producto(s)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-page="Editar" asp-route-id="@c.IdCategoria" class="btn btn-sm btn-outline-secondary">
                                        Editar
                                    </a>
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@c.IdCategoria" onsubmit="return confirm('¿Está seguro de eliminar esta categoría?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" @(c.Productos.Count > 0 ? "title='Tiene productos asignados'" : "")>
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
