@page
@model TiendaRopa.Pages.Admin.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard General";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="admin-header-title">Panel de Control</h1>
        <p class="admin-header-sub">Métricas en tiempo real y resumen operativo de la tienda</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="/Admin/Productos/Crear" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            + Nuevo Producto
        </a>
        <a asp-page="/Admin/Stock/Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            Revisar Stock
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <!-- Ventas -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-card h-100 p-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Ventas Netas</span>
                    <h3 class="fw-bold text-dark mt-2 mb-0">S/ @Model.Resumen.TotalVentas.ToString("N2")</h3>
                    <small class="text-success fw-semibold">Pedidos confirmados</small>
                </div>
                <div class="p-2 rounded bg-success-subtle text-success">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Pedidos -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-card h-100 p-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Pedidos</span>
                    <h3 class="fw-bold text-dark mt-2 mb-0">@Model.Resumen.TotalPedidos</h3>
                    <small class="text-primary fw-semibold">
                        @Model.Resumen.PedidosPendientes pendientes
                    </small>
                </div>
                <div class="p-2 rounded bg-primary-subtle text-primary">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Clientes -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-card h-100 p-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Clientes</span>
                    <h3 class="fw-bold text-dark mt-2 mb-0">@Model.Resumen.TotalClientes</h3>
                    <small class="text-muted">Registrados en tienda</small>
                </div>
                <div class="p-2 rounded bg-info-subtle text-info">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Productos & Variantes -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-card h-100 p-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Productos</span>
                    <h3 class="fw-bold text-dark mt-2 mb-0">@Model.Resumen.TotalProductos</h3>
                    <small class="text-secondary fw-semibold">@Model.Resumen.TotalVariantes variantes en catálogo</small>
                </div>
                <div class="p-2 rounded bg-warning-subtle text-warning">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Estado Operativo de Pedidos & Alertas de Stock -->
<div class="row g-4 mb-4">
    <!-- Resumen de Estados de Pedidos -->
    <div class="col-12 col-lg-6">
        <div class="admin-card h-100">
            <h5 class="fw-bold mb-3 text-dark">Distribución de Pedidos por Estado</h5>
            <div class="d-flex flex-column gap-2">
                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light">
                    <span class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning text-dark">Pendiente</span>
                        <small class="text-muted">Por procesar en tienda</small>
                    </span>
                    <span class="fw-bold fs-6">@Model.Resumen.PedidosPendientes</span>
                </div>
                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light">
                    <span class="d-flex align-items-center gap-2">
                        <span class="badge bg-info text-dark">Preparando</span>
                        <small class="text-muted">En empaquetado o almacén</small>
                    </span>
                    <span class="fw-bold fs-6">@Model.Resumen.PedidosPreparando</span>
                </div>
                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light">
                    <span class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary">Listo</span>
                        <small class="text-muted">Listo para despacho / entrega</small>
                    </span>
                    <span class="fw-bold fs-6">@Model.Resumen.PedidosListos</span>
                </div>
                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light">
                    <span class="d-flex align-items-center gap-2">
                        <span class="badge bg-success">Entregado</span>
                        <small class="text-muted">Concretados con éxito</small>
                    </span>
                    <span class="fw-bold fs-6">@Model.Resumen.PedidosEntregados</span>
                </div>
                <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light">
                    <span class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger">Cancelado</span>
                        <small class="text-muted">Pedidos anulados</small>
                    </span>
                    <span class="fw-bold fs-6">@Model.Resumen.PedidosCancelados</span>
                </div>
            </div>
            <div class="mt-3 text-end">
                <a asp-page="/Admin/Pedidos/Index" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold">
                    Ver todos los pedidos &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- Alertas de Stock -->
    <div class="col-12 col-lg-6">
        <div class="admin-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">Alertas de Stock Crítico</h5>
                <span class="badge bg-danger">@Model.Resumen.ProductosSinStock Agotados</span>
            </div>

            @if (!Model.Resumen.AlertasStock.Any())
            {
                <div class="alert alert-success d-flex align-items-center gap-2 mb-0">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <div>¡Excelente! No hay prendas con stock bajo en este momento.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Prenda</th>
                                <th>Talla</th>
                                <th>Color</th>
                                <th>Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var variante in Model.Resumen.AlertasStock)
                            {
                                <tr>
                                    <td class="fw-semibold">@variante.Producto?.Nombre</td>
                                    <td><span class="badge bg-secondary">@(variante.Talla?.Nombre ?? "N/A")</span></td>
                                    <td><span class="badge bg-info text-dark">@(variante.Color?.Nombre ?? "N/A")</span></td>
                                    <td>
                                        @if (variante.Stock == 0)
                                        {
                                            <span class="badge bg-danger">Agotado (0)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Bajo (@variante.Stock)</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 text-end">
                    <a asp-page="/Admin/Stock/Index" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold">
                        Ir al Centro de Control de Stock &rarr;
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Últimos Pedidos Registrados -->
<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-dark">Últimos Pedidos Registrados</h5>
        <a asp-page="/Admin/Pedidos/Index" class="btn btn-outline-primary btn-sm">Ver Todos</a>
    </div>

    @if (!Model.Resumen.UltimosPedidos.Any())
    {
        <div class="alert alert-info mb-0">
            Aún no se registran pedidos en la tienda pública.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Pedido</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Resumen.UltimosPedidos)
                    {
                        <tr>
                            <td><strong>#@p.IdPedido.ToString("D4")</strong></td>
                            <td>
                                <div><strong>@p.Cliente?.Nombre</strong></div>
                                <small class="text-muted">@p.Cliente?.Correo</small>
                            </td>
                            <td>@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-success fw-bold">S/ @p.Total.ToString("F2")</td>
                            <td>
                                @switch (p.Estado.ToLower())
                                {
                                    case "pendiente":
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                        break;
                                    case "preparando":
                                        <span class="badge bg-info text-dark">Preparando</span>
                                        break;
                                    case "listo":
                                        <span class="badge bg-primary">Listo</span>
                                        break;
                                    case "entregado":
                                        <span class="badge bg-success">Entregado</span>
                                        break;
                                    case "cancelado":
                                        <span class="badge bg-danger">Cancelado</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@p.Estado</span>
                                        break;
                                }
                            </td>
                            <td>
                                <a asp-page="/Admin/Pedidos/Detalle" asp-route-id="@p.IdPedido" class="btn btn-outline-dark btn-sm">
                                    Ver Detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
