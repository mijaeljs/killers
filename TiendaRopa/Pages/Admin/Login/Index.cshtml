@page
@model TiendaRopa.Pages.Admin.Login.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Panel Administrativo — Iniciar Sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --admin-primary: #1e293b;
            --admin-accent: #2563eb;
            --admin-accent-hover: #1d4ed8;
            --admin-bg: #0f172a;
            --admin-card-bg: #ffffff;
            --admin-text: #1e293b;
            --admin-muted: #64748b;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 1.5rem;
            color: var(--admin-text);
        }

        .login-card {
            background: var(--admin-card-bg);
            border-radius: 1.25rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45);
            width: 100%;
            max-width: 440px;
            padding: 2.75rem 2.5rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: #eff6ff;
            color: var(--admin-accent);
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .login-title {
            font-size: 1.65rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.35rem;
        }

        .login-subtitle {
            color: var(--admin-muted);
            font-size: 0.92rem;
            margin-bottom: 2rem;
        }

        .form-label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #334155;
            margin-bottom: 0.35rem;
        }

        .form-control {
            border: 1.5px solid #e2e8f0;
            border-radius: 0.65rem;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            border-color: var(--admin-accent);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
        }

        .btn-admin-login {
            background: var(--admin-accent);
            border: none;
            color: #ffffff;
            font-weight: 600;
            padding: 0.85rem;
            border-radius: 0.65rem;
            font-size: 1rem;
            width: 100%;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }

        .btn-admin-login:hover {
            background: var(--admin-accent-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
        }

        .default-creds-box {
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 0.65rem;
            padding: 0.85rem 1rem;
            font-size: 0.82rem;
            color: #475569;
            margin-top: 1.5rem;
        }

        .back-link {
            display: inline-block;
            color: #94a3b8;
            font-size: 0.88rem;
            text-decoration: none;
            transition: color 0.2s ease;
            margin-top: 1.75rem;
            text-align: center;
            width: 100%;
        }

        .back-link:hover {
            color: #38bdf8;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center">
            <span class="brand-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Acceso Administrativo
            </span>
            <h1 class="login-title">TiendaRopa</h1>
            <p class="login-subtitle">Inicie sesión para gestionar el catálogo y pedidos</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
        {
            <div class="alert alert-danger py-2 px-3 d-flex align-items-center gap-2 mb-3" role="alert" style="font-size: 0.88rem; border-radius: 0.65rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div>@Model.ErrorMensaje</div>
            </div>
        }

        <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <div class="mb-3">
                <label asp-for="UsuarioOCorreo" class="form-label">Usuario o correo</label>
                <input asp-for="UsuarioOCorreo" class="form-control" placeholder="admin o admin@tiendaropa.com" autofocus autocomplete="username" />
                <span asp-validation-for="UsuarioOCorreo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label text-muted small">Recordar sesión</label>
                </div>
            </div>

            <button type="submit" class="btn btn-admin-login">
                Iniciar sesión
            </button>
        </form>

        <div class="default-creds-box">
            <div class="fw-semibold text-dark mb-1">🔑 Acceso Inicial Configurado:</div>
            <div><strong>Usuario:</strong> <code>admin</code></div>
            <div><strong>Contraseña:</strong> <code>Admin123*</code></div>
        </div>

        <a asp-page="/Index" class="back-link">
            ← Volver a la Tienda Pública
        </a>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
