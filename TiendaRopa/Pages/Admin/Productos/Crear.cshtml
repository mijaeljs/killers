@page
@model TiendaRopa.Pages.Admin.Productos.CrearModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nuevo Producto";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="admin-card">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Registrar Nuevo Producto</h4>
                    <small class="text-muted">Paso 1: Registre los datos generales. En el siguiente paso podrá asignarle tallas y colores.</small>
                </div>
                <a asp-page="Index" class="btn btn-sm btn-outline-secondary">← Volver al listado</a>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-semibold">Nombre de la Prenda / Producto</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Polo Oversize Básico, Jeans Slim Fit, Casaca Cortavientos" autofocus />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-semibold">Descripción Detallada</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Indique características, material de confección, corte o temporada..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Precio" class="form-label fw-semibold">Precio de Venta (S/)</label>
                        <div class="input-group">
                            <span class="input-group-text">S/</span>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="IdCategoria" class="form-label fw-semibold">Categoría</label>
                        <select asp-for="IdCategoria" asp-items="Model.Categorias" class="form-select">
                            <option value="">-- Seleccionar Categoría --</option>
                        </select>
                        <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">Guardar y Continuar a Variantes &rarr;</button>
                </div>
            </form>
        </div>
    </div>
</div>
