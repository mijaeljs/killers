@page "{id:int}"
@model TiendaRopa.Pages.Admin.Productos.EditarModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Producto";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="admin-card mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Editar Producto #@Model.IdProducto</h4>
                    <small class="text-muted">Modifique los datos principales de la prenda</small>
                </div>
                <a asp-page="Index" class="btn btn-sm btn-outline-secondary">← Volver al listado</a>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <input type="hidden" asp-for="IdProducto" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-semibold">Nombre de la Prenda</label>
                    <input asp-for="Nombre" class="form-control" autofocus />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-semibold">Descripción Detallada</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Precio" class="form-label fw-semibold">Precio de Venta (S/)</label>
                        <div class="input-group">
                            <span class="input-group-text">S/</span>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="IdCategoria" class="form-label fw-semibold">Categoría</label>
                        <select asp-for="IdCategoria" asp-items="Model.Categorias" class="form-select">
                        </select>
                        <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">Guardar Cambios</button>
                </div>
            </form>
        </div>

        <!-- Variantes del Producto -->
        <div class="admin-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">Variantes de este Producto</h5>
                    <small class="text-muted">Combinaciones de Talla, Color y Stock existentes</small>
                </div>
                <a asp-page="/Admin/Variantes/Crear" asp-route-idProducto="@Model.IdProducto" class="btn btn-sm btn-outline-primary">
                    + Agregar Variante
                </a>
            </div>

            @if (!Model.Variantes.Any())
            {
                <div class="alert alert-warning mb-0">
                    Este producto no tiene variantes configuradas. ¡Recuerde que los clientes no podrán comprarlo en la tienda pública sin variantes activas con stock!
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Talla</th>
                                <th>Color</th>
                                <th>Stock</th>
                                <th style="width: 140px;" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Variantes)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@(v.Talla?.Nombre ?? "N/A")</span></td>
                                    <td><span class="badge bg-info text-dark">@(v.Color?.Nombre ?? "N/A")</span></td>
                                    <td>
                                        @if (v.Stock == 0)
                                        {
                                            <span class="badge bg-danger">Agotado (0)</span>
                                        }
                                        else if (v.Stock <= 5)
                                        {
                                            <span class="badge bg-warning text-dark">Bajo (@v.Stock)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@v.Stock unidades</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="/Admin/Variantes/Editar" asp-route-id="@v.IdVariante" class="btn btn-sm btn-outline-secondary">
                                            Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
