@page
@model TiendaRopa.Pages.Admin.Clientes.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="admin-header-title">Clientes Registrados</h1>
        <p class="admin-header-sub">Directorio de usuarios y resumen de compras en la tienda pública</p>
    </div>
</div>

<!-- Buscador -->
<div class="admin-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-9">
            <input type="text" asp-for="Buscar" class="form-control" placeholder="Buscar por nombre, correo o teléfono de cliente..." />
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-100">Buscar</button>
            @if (!string.IsNullOrEmpty(Model.Buscar))
            {
                <a asp-page="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </form>
</div>

<!-- Tabla de Clientes -->
<div class="admin-card">
    @if (!Model.Clientes.Any())
    {
        <div class="alert alert-info mb-0">
            No se encontraron clientes registrados con los filtros aplicados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Cliente</th>
                        <th>Contacto</th>
                        <th>Dirección de Entrega</th>
                        <th>Pedidos Realizados</th>
                        <th>Total Compras</th>
                        <th style="width: 140px;" class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Clientes)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@c.IdCliente</span></td>
                            <td>
                                <div><strong class="text-dark">@c.Nombre</strong></div>
                                <small class="text-muted">@c.Correo</small>
                            </td>
                            <td>
                                <div><small class="fw-semibold">Tel:</small> @(string.IsNullOrEmpty(c.Telefono) ? "No especificado" : c.Telefono)</div>
                            </td>
                            <td>
                                <small class="text-muted">@(string.IsNullOrEmpty(c.Direccion) ? "Sin dirección" : c.Direccion)</small>
                            </td>
                            <td>
                                <span class="badge @(c.TotalPedidos > 0 ? "bg-primary" : "bg-secondary")">
                                    @c.TotalPedidos pedido(s)
                                </span>
                            </td>
                            <td class="text-success fw-bold">
                                S/ @c.TotalGastado.ToString("F2")
                            </td>
                            <td class="text-end">
                                <a asp-page="Detalle" asp-route-id="@c.IdCliente" class="btn btn-sm btn-outline-dark">
                                    Ver Pedidos
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
