@page "{id:int}"
@model TiendaRopa.Pages.Admin.Clientes.DetalleModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Cliente: {Model.Cliente?.Nombre}";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="admin-header-title">Perfil del Cliente</h1>
        <p class="admin-header-sub">Historial detallado de compras y datos de contacto</p>
    </div>
    <a asp-page="Index" class="btn btn-sm btn-outline-secondary">← Volver a Clientes</a>
</div>

<div class="row g-4 mb-4">
    <!-- Información del Cliente -->
    <div class="col-12 col-md-4">
        <div class="admin-card h-100">
            <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">Información Personal</h5>
            <div class="mb-2">
                <span class="text-muted small d-block">Nombre completo:</span>
                <strong class="text-dark fs-6">@Model.Cliente?.Nombre</strong>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Correo electrónico:</span>
                <span class="text-dark">@Model.Cliente?.Correo</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Teléfono de contacto:</span>
                <span class="text-dark">@(string.IsNullOrEmpty(Model.Cliente?.Telefono) ? "No registrado" : Model.Cliente?.Telefono)</span>
            </div>
            <div class="mb-2">
                <span class="text-muted small d-block">Dirección registrada:</span>
                <span class="text-dark">@(string.IsNullOrEmpty(Model.Cliente?.Direccion) ? "Sin dirección registrada" : Model.Cliente?.Direccion)</span>
            </div>
        </div>
    </div>

    <!-- Pedidos Realizados -->
    <div class="col-12 col-md-8">
        <div class="admin-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                <h5 class="fw-bold mb-0 text-dark">Historial de Pedidos Realizados</h5>
                <span class="badge bg-dark">@Model.Pedidos.Count pedido(s)</span>
            </div>

            @if (!Model.Pedidos.Any())
            {
                <div class="alert alert-info mb-0">
                    Este cliente aún no ha concretado ningún pedido.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>N° Pedido</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Pedidos)
                            {
                                <tr>
                                    <td><strong>#@p.IdPedido.ToString("D4")</strong></td>
                                    <td>@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-success fw-bold">S/ @p.Total.ToString("F2")</td>
                                    <td>
                                        @switch (p.Estado.ToLower())
                                        {
                                            case "pendiente":
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                                break;
                                            case "preparando":
                                                <span class="badge bg-info text-dark">Preparando</span>
                                                break;
                                            case "listo":
                                                <span class="badge bg-primary">Listo</span>
                                                break;
                                            case "entregado":
                                                <span class="badge bg-success">Entregado</span>
                                                break;
                                            case "cancelado":
                                                <span class="badge bg-danger">Cancelado</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@p.Estado</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="/Admin/Pedidos/Detalle" asp-route-id="@p.IdPedido" class="btn btn-sm btn-outline-dark">
                                            Ver Detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
