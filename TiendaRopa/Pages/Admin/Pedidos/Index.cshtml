@page
@model TiendaRopa.Pages.Admin.Pedidos.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Pedidos";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="admin-header-title">Gestión de Pedidos</h1>
        <p class="admin-header-sub">Monitoreo de compras, cambio de estado de preparación y despacho</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-dark fs-6 d-flex align-items-center">Total: @Model.TotalPedidos pedido(s)</span>
        <span class="badge bg-success fs-6 d-flex align-items-center">Ventas: S/ @Model.TotalVentas.ToString("F2")</span>
    </div>
</div>

<!-- Filtros y Búsqueda -->
<div class="admin-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-6">
            <input type="text" asp-for="Buscar" class="form-control" placeholder="Buscar por número de pedido o nombre de cliente..." />
        </div>
        <div class="col-12 col-sm-6 col-md-4">
            <select asp-for="EstadoFiltro" class="form-select">
                <option value="">-- Todos los Estados --</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Preparando">Preparando</option>
                <option value="Listo">Listo</option>
                <option value="Entregado">Entregado</option>
                <option value="Cancelado">Cancelado</option>
            </select>
        </div>
        <div class="col-12 col-sm-6 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-100">Filtrar</button>
            @if (!string.IsNullOrEmpty(Model.Buscar) || !string.IsNullOrEmpty(Model.EstadoFiltro))
            {
                <a asp-page="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </form>
</div>

<!-- Tabla de Pedidos -->
<div class="admin-card">
    @if (!Model.Pedidos.Any())
    {
        <div class="alert alert-info mb-0">
            No se encontraron pedidos registrados con los filtros aplicados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 90px;">N°</th>
                        <th>Cliente</th>
                        <th>Fecha de Pedido</th>
                        <th>Monto Total</th>
                        <th>Estado Actual</th>
                        <th style="width: 250px;">Cambiar Estado</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pedido in Model.Pedidos)
                    {
                        <tr>
                            <td><strong class="text-dark">#@pedido.IdPedido.ToString("D4")</strong></td>
                            <td>
                                <div><strong class="text-dark">@pedido.Cliente?.Nombre</strong></div>
                                <small class="text-muted">@pedido.Cliente?.Correo</small>
                            </td>
                            <td>@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-success fw-bold">S/ @pedido.Total.ToString("F2")</td>
                            <td>
                                @switch (pedido.Estado.ToLower())
                                {
                                    case "pendiente":
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                        break;
                                    case "preparando":
                                        <span class="badge bg-info text-dark">Preparando</span>
                                        break;
                                    case "listo":
                                        <span class="badge bg-primary">Listo</span>
                                        break;
                                    case "entregado":
                                        <span class="badge bg-success">Entregado</span>
                                        break;
                                    case "cancelado":
                                        <span class="badge bg-danger">Cancelado</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@pedido.Estado</span>
                                        break;
                                }
                            </td>
                            <td>
                                <form method="post" asp-page-handler="CambiarEstado" class="d-flex gap-2">
                                    <input type="hidden" name="idPedido" value="@pedido.IdPedido" />
                                    <select name="nuevoEstado" class="form-select form-select-sm">
                                        <option value="Pendiente" selected="@(pedido.Estado == "Pendiente")">Pendiente</option>
                                        <option value="Preparando" selected="@(pedido.Estado == "Preparando")">Preparando</option>
                                        <option value="Listo" selected="@(pedido.Estado == "Listo")">Listo</option>
                                        <option value="Entregado" selected="@(pedido.Estado == "Entregado")">Entregado</option>
                                        <option value="Cancelado" selected="@(pedido.Estado == "Cancelado")">Cancelado</option>
                                    </select>
                                    <button type="submit" class="btn btn-outline-dark btn-sm">Actualizar</button>
                                </form>
                            </td>
                            <td class="text-end">
                                <a asp-page="Detalle" asp-route-id="@pedido.IdPedido" class="btn btn-outline-primary btn-sm">
                                    Ver Detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
