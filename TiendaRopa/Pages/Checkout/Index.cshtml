@page
@model TiendaRopa.Pages.Checkout.IndexModel
@{
    ViewData["Title"] = "Confirmar Compra (Checkout)";
}

<div class="mb-4">
    <h2>Revisar y Confirmar Pedido</h2>
    <p class="text-muted">Por favor, verifica tus datos personales y los productos antes de confirmar la compra.</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <!-- Datos del Cliente -->
    <div class="col-md-5 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Datos del Cliente</h5>
            </div>
            <div class="card-body">
                @if (Model.Cliente != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Nombre:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Cliente.Nombre</dd>

                        <dt class="col-sm-4 text-muted">Correo:</dt>
                        <dd class="col-sm-8">@Model.Cliente.Correo</dd>

                        <dt class="col-sm-4 text-muted">Teléfono:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Cliente.Telefono) ? "No especificado" : Model.Cliente.Telefono)</dd>

                        <dt class="col-sm-4 text-muted">Dirección:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Cliente.Direccion) ? "No especificada" : Model.Cliente.Direccion)</dd>
                    </dl>
                }
            </div>
            <div class="card-footer bg-light text-muted small">
                Los productos serán enviados a la dirección indicada.
            </div>
        </div>
    </div>

    <!-- Resumen de Productos -->
    <div class="col-md-7 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Productos en el Pedido</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Talla</th>
                                <th>Color</th>
                                <th>Precio</th>
                                <th>Cant.</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Carrito?.Items != null)
                            {
                                @foreach (var item in Model.Carrito.Items)
                                {
                                    var subtotal = (item.Variante?.Producto?.Precio ?? 0) * item.Cantidad;
                                    <tr>
                                        <td><strong>@item.Variante?.Producto?.Nombre</strong></td>
                                        <td><span class="badge bg-secondary">@(item.Variante?.Talla?.Nombre ?? "N/A")</span></td>
                                        <td><span class="badge bg-info text-dark">@(item.Variante?.Color?.Nombre ?? "N/A")</span></td>
                                        <td>S/ @item.Variante?.Producto?.Precio.ToString("F2")</td>
                                        <td>@item.Cantidad</td>
                                        <td><strong>S/ @subtotal.ToString("F2")</strong></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">TOTAL:</h4>
                    <h3 class="mb-0 text-success fw-bold">S/ @Model.Total.ToString("F2")</h3>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-page="/Carrito/Index" class="btn btn-outline-secondary">← Volver al Carrito</a>
                    <form method="post" asp-page-handler="Confirmar">
                        <button type="submit" class="btn btn-success btn-lg">
                            ✓ Confirmar Pedido
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
