@page
@model TiendaRopa.Pages.Pedidos.Admin.IndexModel
@{
    ViewData["Title"] = "Panel de Administración - Pedidos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Panel de Administración — Pedidos</h2>
    <span class="badge bg-dark">Total pedidos: @Model.Pedidos.Count</span>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Pedidos.Any())
{
    <div class="alert alert-info">
        No se han registrado pedidos en el sistema.
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>N°</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado Actual</th>
                    <th style="width: 250px;">Cambiar Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model.Pedidos)
                {
                    <tr>
                        <td><strong>#@pedido.IdPedido.ToString("D4")</strong></td>
                        <td>
                            <div><strong>@pedido.Cliente?.Nombre</strong></div>
                            <small class="text-muted">@pedido.Cliente?.Correo</small>
                        </td>
                        <td>@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-success fw-bold">S/ @pedido.Total.ToString("F2")</td>
                        <td>
                            @switch (pedido.Estado.ToLower())
                            {
                                case "pendiente":
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                    break;
                                case "preparando":
                                    <span class="badge bg-info text-dark">Preparando</span>
                                    break;
                                case "listo":
                                    <span class="badge bg-primary">Listo</span>
                                    break;
                                case "entregado":
                                    <span class="badge bg-success">Entregado</span>
                                    break;
                                case "cancelado":
                                    <span class="badge bg-danger">Cancelado</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@pedido.Estado</span>
                                    break;
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="CambiarEstado" class="d-flex gap-2">
                                <input type="hidden" name="idPedido" value="@pedido.IdPedido" />
                                <select name="nuevoEstado" class="form-select form-select-sm">
                                    <option value="Pendiente" selected="@(pedido.Estado == "Pendiente")">Pendiente</option>
                                    <option value="Preparando" selected="@(pedido.Estado == "Preparando")">Preparando</option>
                                    <option value="Listo" selected="@(pedido.Estado == "Listo")">Listo</option>
                                    <option value="Entregado" selected="@(pedido.Estado == "Entregado")">Entregado</option>
                                    <option value="Cancelado" selected="@(pedido.Estado == "Cancelado")">Cancelado</option>
                                </select>
                                <button type="submit" class="btn btn-outline-dark btn-sm">Actualizar</button>
                            </form>
                        </td>
                        <td>
                            <a asp-page="/Pedidos/Detalle" asp-route-id="@pedido.IdPedido" class="btn btn-outline-primary btn-sm">
                                Ver Detalle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
